# Copie para .env (ignorado pelo git) ou exporte as variaveis. Nao ha valores padrao de segredo.

# DSN somente leitura da SHOSP. Aceita o prefixo jdbc:, que e removido.
# Exemplo: postgresql://<usuario>:<senha>@localhost:5435/dbpgshosp_dev
SHOSP_DB_URL=

# Tamanho de lote por entidade (definido antes de cada carga)
BATCH_SIZE_ORGANIZATION=
BATCH_SIZE_PHYSICIAN=
BATCH_SIZE_PATIENT=
BATCH_SIZE_PRESCRIPTION=

# statement_timeout das sessoes com a SHOSP
SOURCE_STATEMENT_TIMEOUT_SECONDS=

# Opcionais
# SOURCE_POOL_MAX_SIZE=4
# INCLUDE_VACCINES=false
